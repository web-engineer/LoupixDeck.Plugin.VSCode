<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LoupixDeck.Plugin.VSCode</AssemblyName>
    <RootNamespace>LoupixDeck.Plugin.VSCode</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Authors>web-engineer</Authors>
    <Company>Web-Engine Limited</Company>
    <Copyright>Copyright (c) 2026 Web-Engine Limited, trading as web-engineer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Visual Studio Code from the deck: commands by ID through a companion extension, live problems, git, debug and task keys, and folders of tasks, launch configurations, problems and open editors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests and the profile builder are projects of their own. -->
    <Compile Remove="tests/**;tools/**;extension/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoupixDeck.Plugin.VSCode.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host provides the SDK assembly at runtime; never ship it next to the plugin. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.30.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="icon.png" LogicalName="LoupixDeck.Plugin.VSCode.icon.png" />
  </ItemGroup>


  <!--
    Packs the companion VS Code extension (extension/) into loupixdeck-companion.vsix next to the
    plugin, so the settings page can install it with the editor's own CLI. A .vsix is a zip with a
    fixed layout; packing it here keeps the build free of node. Publishing to a marketplace uses
    "npx @vscode/vsce package" instead (see extension/README.md).
  -->
  <ItemGroup>
    <CompanionFiles Include="extension/package.json;extension/extension.js;extension/README.md;extension/CHANGELOG.md;extension/LICENSE;extension/icon.png" />
    <CompanionLibFiles Include="extension/lib/**/*.js" />
  </ItemGroup>

  <Target Name="PackCompanion" AfterTargets="Build" Inputs="@(CompanionFiles);@(CompanionLibFiles);extension/vsix/extension.vsixmanifest;extension/vsix/[Content_Types].xml" Outputs="$(OutDir)loupixdeck-companion.vsix">
    <PropertyGroup>
      <CompanionStage>$(IntermediateOutputPath)vsix/</CompanionStage>
    </PropertyGroup>
    <RemoveDir Directories="$(CompanionStage)" />
    <Copy SourceFiles="@(CompanionFiles)" DestinationFolder="$(CompanionStage)extension/" />
    <!-- %(RecursiveDir) is relative to the ** in the include, so the lib/ prefix is added here. -->
    <Copy SourceFiles="@(CompanionLibFiles)" DestinationFiles="@(CompanionLibFiles->'$(CompanionStage)extension/lib/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="extension/vsix/extension.vsixmanifest;extension/vsix/[Content_Types].xml" DestinationFolder="$(CompanionStage)" />
    <ZipDirectory SourceDirectory="$(CompanionStage)" DestinationFile="$(OutDir)loupixdeck-companion.vsix" Overwrite="true" />
  </Target>

  <!--
    Post-build copy into the LoupixDeck plugin folder so every build is picked up by the host.
    Pass -p:LoupixDebugHost=true to target a Debug build of the host, which reads
    ~/.config/LoupixDeck/debug/plugins instead of ~/.config/LoupixDeck/plugins.
  -->
  <PropertyGroup>
    <LoupixDebugSuffix Condition="'$(LoupixDebugHost)' == 'true'">/debug</LoupixDebugSuffix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <PluginInstallDir>$(AppData)\LoupixDeck\plugins\vscode</PluginInstallDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <PluginInstallDir>$(HOME)/.config/LoupixDeck$(LoupixDebugSuffix)/plugins/vscode</PluginInstallDir>
  </PropertyGroup>

  <Target Name="CopyToPluginFolder" AfterTargets="PackCompanion" Condition="'$(LoupixSkipInstall)' != 'true'">
    <MakeDir Directories="$(PluginInstallDir)" />
    <ItemGroup>
      <PluginFiles Include="$(OutDir)**\*.*"
                   Exclude="$(OutDir)LoupixDeck.PluginSdk.*;$(OutDir)*.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)"
          DestinationFolder="$(PluginInstallDir)/%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/plugin.json"
          DestinationFolder="$(PluginInstallDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="VSCode plugin copied to $(PluginInstallDir)" />
  </Target>

</Project>
